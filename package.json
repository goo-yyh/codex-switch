{
  "name": "codex-switch-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "pnpm --filter @codex-switch/desktop dev",
    "desktop": "pnpm --filter @codex-switch/desktop tauri dev",
    "website": "pnpm --filter @codex-switch/website dev --host 127.0.0.1",
    "build": "pnpm -r build",
    "test": "pnpm --filter @codex-switch/desktop test && cargo test --locked -p codex-switch-core -p cc-switch-codex -p codex-switch-desktop",
    "check": "pnpm --filter @codex-switch/desktop check && pnpm --filter @codex-switch/website check",
    "test:providers": "cargo run -p codex-switch-core --bin provider-check --",
    "test:providers:compact": "cargo run -p codex-switch-core --bin provider-compact-check --",
    "test:providers:summary": "cargo run -p codex-switch-core --bin provider-compact-check -- --summary",
    "check:secrets": "python3 scripts/check_secrets.py",
    "indexnow:submit": "node scripts/submit_indexnow.mjs",
    "check:seo": "python3 scripts/check_site_seo.py",
    "check:links": "python3 scripts/check_site_links.py",
    "icons": "node scripts/generate-icons.mjs",
    "check:upstream": "python3 scripts/check_cc_switch_upstream.py",
    "build:website": "pnpm --filter @codex-switch/website build",
    "preview:website": "node scripts/preview_website.mjs",
    "check:deployment": "node --test scripts/test_website_deployment.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "engines": {
    "node": "22.x"
  }
}
