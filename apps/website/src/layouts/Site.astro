---
import '../styles/site.css';
import product from '../../../../packages/product-info/product.json';
import Seo from '../components/Seo.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { localeFromPath, localizedPath } from '../lib/i18n';
interface Props {
  title?: string;
  description?: string;
}
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const link = (path: string) => localizedPath(path, locale);
const {
  title = en
    ? 'Codex Switch — Connect Codex App to your models'
    : 'Codex Switch — 为 Codex App 接入国内模型与自定义 API',
  description = en
    ? 'Connect Codex App to DeepSeek, Kimi, Qwen, GLM, MiniMax and custom APIs. Manage multiple models, adapt Chat and Responses APIs, and back up and restore settings locally.'
    : 'Codex Switch 为 Codex App 接入 DeepSeek、Kimi、千问、GLM、MiniMax 与自定义 API。支持多配置多模型、Responses 与 Chat 协议适配，开启前备份、关闭后恢复，密钥保存在系统凭据库。',
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} />
    <meta name="theme-color" content="#fafaff" /><link
      rel="icon"
      type="image/png"
      href="/mark.png"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={link('/')} aria-label={en ? 'Codex Switch home' : 'Codex Switch 首页'}
        ><img src="/mark.png" alt="" width="30" height="30" />Codex Switch</a
      >
      <nav aria-label={en ? 'Main navigation' : '主导航'}>
        <a href={link('/docs/overview/')}>{en ? 'Docs' : '文档'}</a>
        <a href={link('/docs/providers/')}>{en ? 'Providers' : '支持的服务'}</a>
        <a class="nav-github" href={product.repository}>GitHub ↗</a>
        <LanguageSwitch />
        <a class="button small" href={link('/download/')}
          >{en ? 'Get the app' : '获取应用'} <span>↗</span></a
        >
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <a class="brand" href={link('/')}
          ><img src="/mark.png" alt="" width="25" height="25" />Codex Switch</a
        >
        <p>{en ? 'More choice for your Codex.' : '为你的 Codex，多一个选择。'}</p>
        <small
          >{
            en
              ? 'An independent open-source project. Not affiliated with OpenAI.'
              : '社区独立开源项目，与 OpenAI 无隶属关系。'
          }</small
        >
      </div>
      <div class="footer-links">
        <a href={link('/docs/quickstart/')}>{en ? 'Quickstart' : '快速开始'}</a>
        <a href={link('/docs/changelog/')}>{en ? 'Changelog' : '更新日志'}</a>
        <a href={link('/docs/privacy/')}>{en ? 'Privacy' : '隐私说明'}</a>
        <a href={link('/docs/open-source/')}>{en ? 'Open-source credits' : '开源致谢'}</a>
        <a href={`${product.repository}/issues`}>{en ? 'Report an issue' : '反馈问题'} ↗</a>
      </div><span class="footer-copy">© 2026 Codex Switch · MIT</span>
    </footer>
  </body>
</html>
