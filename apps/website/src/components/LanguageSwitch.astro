---
import { localeFromPath, localizedPath } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const target = locale === 'en' ? 'zh-CN' : 'en';
---

<a
  class="language-switch"
  href={localizedPath(Astro.url.pathname, target)}
  lang={target}
  hreflang={target}
  aria-label={locale === 'en' ? 'Switch to Simplified Chinese' : '切换到英文'}
  >{target === 'en' ? 'English' : '简体中文'}</a
>
<style>
  .language-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 0.5rem;
    border: 1px solid currentColor;
    border-radius: 0.45rem;
    font-size: 0.8rem;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    opacity: 0.85;
  }
  .language-switch:hover {
    opacity: 1;
  }
</style>
