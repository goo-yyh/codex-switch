---
interface Props {
  product?: 'switch' | 'codex';
  lang?: 'zh' | 'en';
}
const { product = 'switch', lang = 'zh' } = Astro.props;
const en = lang === 'en';
const isSwitch = product === 'switch';
const label = `${en ? 'Download' : '下载'} ${isSwitch ? 'Codex Switch' : 'Codex App'}`;
const base = 'https://github.com/goo-yyh/codex-switch/releases/latest';
const items = isSwitch
  ? [
      ['macOS · Apple Silicon', `${base}/download/Codex-Switch_aarch64.dmg`],
      ['macOS · Intel', `${base}/download/Codex-Switch_x64.dmg`],
      ['Windows · x64', `${base}/download/Codex-Switch_x64-setup.exe`],
    ]
  : [
      ['macOS · Apple Silicon', 'https://persistent.oaistatic.com/codex-app-prod/Codex.dmg'],
      ['macOS · Intel', 'https://persistent.oaistatic.com/codex-app-prod/Codex-latest-x64.dmg'],
      ['Windows', 'https://get.microsoft.com/installer/download/9PLM9XGG6VKS?cid=website_cta_psi'],
    ];
---

<details class:list={['download-menu', { secondary: !isSwitch }]}>
  <summary>{label}<span aria-hidden="true">⌄</span></summary>
  <div class="download-panel">
    {
      items.map(([name, href]) => (
        <a href={href}>
          <span aria-hidden="true">↓</span>
          {name}
        </a>
      ))
    }
    <a class="download-footer" href={isSwitch ? base : 'https://learn.chatgpt.com/docs/app'}>
      {
        isSwitch
          ? en
            ? 'Release notes and checksums ↗'
            : '发布说明与校验文件 ↗'
          : en
            ? 'Official installation guide ↗'
            : '官方安装指南 ↗'
      }
    </a>
  </div>
</details>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    const target = event.target;
    document.querySelectorAll<HTMLDetailsElement>('.download-menu[open]').forEach((menu) => {
      if (!menu.contains(target) || (target instanceof Element && target.closest('a')))
        menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.download-menu[open]').forEach((menu) => {
      if (menu.contains(document.activeElement)) menu.querySelector('summary')?.focus();
      menu.open = false;
    });
  });
</script>

<style>
  .download-menu {
    position: relative;
    display: inline-block;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.8rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--docs-ink);
    border-radius: 0.65rem;
    background: var(--docs-ink);
    color: var(--docs-surface);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .secondary summary {
    background: var(--docs-surface);
    color: var(--docs-ink);
    border-color: var(--docs-border);
  }
  summary:hover {
    opacity: 0.85;
  }
  .download-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 20;
    width: max-content;
    min-width: 100%;
    max-width: calc(100vw - 2.5rem);
    padding: 0.4rem;
    border: 1px solid var(--docs-border);
    border-radius: 0.75rem;
    background: var(--docs-surface);
    box-shadow: 0 8px 30px #0002;
  }
  .download-panel a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.7rem 0.8rem;
    border-radius: 0.4rem;
    color: var(--docs-ink);
    text-decoration: none;
  }
  .download-panel a:hover {
    background: var(--docs-soft);
  }
  .download-panel .download-footer {
    margin-top: 0.3rem;
    border-top: 1px solid var(--docs-border);
    border-radius: 0;
    font-size: 0.8rem;
    color: var(--docs-muted);
  }
</style>
