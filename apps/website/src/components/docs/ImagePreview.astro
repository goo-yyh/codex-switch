---
import { localeFromPath } from '../../lib/i18n';
const en = localeFromPath(Astro.url.pathname) === 'en';
---

<docs-image-preview>
  <dialog class="image-preview" aria-label={en ? 'Image preview' : '图片预览'}>
    <button type="button" autofocus aria-label={en ? 'Close image preview' : '关闭图片预览'}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m6 6 12 12M6 18 18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <img alt="" />
  </dialog>
</docs-image-preview>

<script>
  class DocsImagePreview extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      const dialog = this.querySelector('dialog')!;
      const image = this.querySelector('img')!;
      const close = this.querySelector('button')!;
      let trigger: HTMLAnchorElement | null = null;
      this.events = new AbortController();
      const { signal } = this.events;

      // Keep the original image links usable without JavaScript and for modifier clicks.
      document.addEventListener(
        'click',
        (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          const link =
            event.target instanceof Element
              ? event.target.closest<HTMLAnchorElement>('.sl-markdown-content a[href]')
              : null;
          const thumbnail = link?.querySelector('img');
          if (!link || !thumbnail || link.hasAttribute('download')) return;
          const url = new URL(link.href);
          if (url.origin !== location.origin || !url.pathname.startsWith('/screenshots/')) return;

          event.preventDefault();
          trigger = link;
          image.src = url.href;
          image.alt = thumbnail.alt;
          // A native modal keeps focus inside the preview and handles Escape.
          dialog.showModal();
        },
        { signal },
      );
      close.addEventListener('click', () => dialog.close(), { signal });
      dialog.addEventListener(
        'click',
        (event) => {
          if (event.target === dialog) dialog.close();
        },
        { signal },
      );
      dialog.addEventListener(
        'close',
        () => {
          image.removeAttribute('src');
          trigger?.focus({ preventScroll: true });
          trigger = null;
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.events?.abort();
      this.querySelector('dialog')?.close();
    }
  }
  customElements.define('docs-image-preview', DocsImagePreview);
</script>

<style>
  :global(html:has(dialog.image-preview[open])) {
    overflow: hidden;
  }
  dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: calc(72px + env(safe-area-inset-top)) 24px calc(24px + env(safe-area-inset-bottom));
    border: 0;
    background: transparent;
    color: #fff;
    cursor: zoom-out;
  }
  dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 88%);
  }
  button {
    position: absolute;
    top: calc(16px + env(safe-area-inset-top));
    right: calc(20px + env(safe-area-inset-right));
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: #262626;
    color: #fff;
    cursor: pointer;
  }
  button:hover {
    background: #404040;
  }
  button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    object-fit: contain;
    cursor: default;
  }
  @media (max-width: 50rem) {
    dialog {
      padding-inline: 12px;
    }
  }
</style>
