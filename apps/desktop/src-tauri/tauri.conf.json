{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch",
  "version": "0.3.0",
  "identifier": "com.codexdocs.switch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Switch",
        "width": 800,
        "height": 740,
        "minWidth": 600,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "shortDescription": "为 Codex App 配置模型连接",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/brand/providers/LICENSE.lobe-icons": "licenses/Lobe-Icons.txt",
      "../../../crates/cc-switch-codex/LICENSE": "licenses/CC-Switch.txt",
      "../../../crates/cc-switch-codex/UPSTREAM.md": "licenses/CC-Switch-UPSTREAM.md"
    }
  }
}
